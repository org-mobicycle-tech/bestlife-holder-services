// wrangler.jsonc -- bestlife-holder-store: Keeps your evidence in your own storage (R2), its index in your own database (D1), and recent reads in your own cache (KV).
// Deployed into YOUR Cloudflare account by its Deploy to Cloudflare button. No account id is written here: it
// is your account. Nothing is exposed: no workers.dev and no preview URL (see README.md for how it is reached).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bestlife-holder-store",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"vars": {
		"BESTLIFE_CALLER_CN": ""
	},
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "bestlife-evidence"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bestlife-index"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE"
		}
	]
}
