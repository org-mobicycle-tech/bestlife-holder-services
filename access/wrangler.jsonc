// wrangler.jsonc -- bestlife-holder-access: Seals and opens your keys with your own encryption key, and hands them only to your other Best Life workers.
// Deployed into YOUR Cloudflare account by its Deploy to Cloudflare button. No account id is written here: it
// is your account. Nothing is exposed: no workers.dev and no preview URL (see README.md for how it is reached).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bestlife-holder-access",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"kv_namespaces": [
		{
			"binding": "KEYS"
		}
	]
}
