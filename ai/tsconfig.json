{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020",
      "WebWorker"
    ],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
