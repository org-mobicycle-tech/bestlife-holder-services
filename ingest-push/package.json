{
  "name": "bestlife-holder-ingest-push",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Receives the mail Email Routing sends it, files each message in your store, and tells Best Life it arrived (metadata only).",
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test/push.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "cloudflare": {
    "label": "Best Life holder \u00b7 ingest-push",
    "bindings": {
      "STORE": {
        "description": "Your store worker (deploy bestlife-holder-store first)."
      }
    }
  }
}
