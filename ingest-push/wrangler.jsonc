// wrangler.jsonc -- bestlife-holder-ingest-push: Receives the mail Email Routing sends it, files each message in your store, and tells Best Life it arrived (metadata only).
// Deployed into YOUR Cloudflare account by its Deploy to Cloudflare button. No account id is written here: it
// is your account. Nothing is exposed: no workers.dev and no preview URL (see README.md for how it is reached).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bestlife-holder-ingest-push",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"services": [
		{
			"binding": "STORE",
			"service": "bestlife-holder-store"
		}
	]
}
